---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found | Jirapat Chaumaungphan">
  <main id="main" class="not-found blueprint on-ink">
    <span class="eyebrow">Error 404</span>
    <h1>This page wandered off the map.</h1>
    <a class="btn btn-primary" href="/">Back to the homepage</a>
  </main>
</Base>

<style>
  .not-found {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 20px;
    padding: 24px;
    text-align: center;
  }

  h1 {
    font-size: clamp(32px, 5vw, 56px);
  }
</style>
