---
import '@fontsource-variable/space-grotesk';
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import { goatcounterCode, profile } from '../data/site';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${profile.name} | ${profile.role}`,
  description = 'Portfolio of Jirapat Chaumaungphan: computer-vision robots, LLM/RAG applications, and ROS2 robotics.',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og-image.jpg', Astro.site);
// Cookie-free GoatCounter analytics: production builds only, and only once a site code is set.
// Links with data-goatcounter-click are counted as events by count.js.
const analyticsEndpoint =
  import.meta.env.PROD && goatcounterCode ? `https://${goatcounterCode}.goatcounter.com/count` : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#161412" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <script is:inline>document.documentElement.classList.add('js');</script>
    {analyticsEndpoint && (
      <script is:inline async data-goatcounter={analyticsEndpoint} src="https://gc.zgo.at/count.js"></script>
    )}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
    <script>
      // Reveal elements as they scroll into view; grid children stagger by column
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        },
        { rootMargin: '0px 0px -80px 0px' },
      );
      document.querySelectorAll<HTMLElement>('[data-reveal]').forEach((el) => {
        const delay = el.dataset.reveal;
        if (delay) el.style.transitionDelay = `${Number(delay) * 110}ms`;
        observer.observe(el);
      });
    </script>
  </body>
</html>
