---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import portrait from '../assets/profile.webp';
import { profile, work, education, languages } from '../data/site';

const [currentJob] = work;
const facts = [
  { label: 'Now', value: `${currentJob.role}, ${currentJob.org.replace(' Co., Ltd.', '')}` },
  { label: 'Studied', value: `${education.degree}, ${education.school}` },
  { label: 'Builds', value: 'Software design & planning · Mechanical parts · Basic electrical systems' },
  { label: 'Learning', value: 'AI harness design · RAG applications' },
  { label: 'Languages', value: languages.map((l) => `${l.name}: ${l.level}`).join(' · ') },
];
---

<section id="about" class="about" aria-labelledby="about-title">
  <div class="container about-grid">
    <figure class="about-photo" data-reveal>
      <Image src={portrait} alt="Portrait of Jirapat Chaumaungphan" widths={[320, 480, 640]} sizes="(min-width: 980px) 400px, 80vw" />
    </figure>
    <div class="about-copy" data-reveal="1">
      <span class="eyebrow">02 / About</span>
      <h2 id="about-title">Hi, I'm {profile.name.split(' ')[0]}.</h2>
      {profile.about.map((text) => <p class="about-text">{text}</p>)}
      <dl class="about-facts">
        {facts.map((f) => (
          <>
            <dt>{f.label}</dt>
            <dd>{f.value}</dd>
          </>
        ))}
      </dl>
      <div class="about-actions">
        <a class="btn btn-dark" href={profile.cv} download><span class="play"><Icon name="download" size={14} /></span> Download CV</a>
        <a class="text-link" href={`mailto:${profile.email}`}>Email me <Icon name="arrow-right" size={16} /></a>
      </div>
    </div>
  </div>
</section>

<style>
  .about {
    padding-block: 88px;
    border-top: 1px solid rgba(22, 20, 18, 0.1);
  }

  .about-grid {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
    gap: clamp(32px, 6vw, 80px);
    align-items: center;
  }

  /* Photo with the offset clay frame used elsewhere for the hero robot */
  .about-photo {
    position: relative;
    margin: 0 18px 18px 0;
    max-width: 400px;
    justify-self: center;
  }

  .about-photo::before {
    content: '';
    position: absolute;
    inset: 0;
    transform: translate(18px, 18px);
    border: 2px solid var(--clay-bright);
    border-radius: var(--radius);
  }

  .about-photo img {
    position: relative;
    width: 100%;
    height: auto;
    border-radius: var(--radius);
    background: linear-gradient(180deg, #FBF9F6 0%, #EDE6DE 100%);
    border: 1px solid var(--line);
  }

  .about-copy {
    display: flex;
    flex-direction: column;
    gap: 20px;
    min-width: 0;
  }

  h2 {
    font-size: clamp(32px, 4.5vw, 52px);
    letter-spacing: -0.02em;
  }

  .about-text {
    font-size: 18px;
    line-height: 1.7;
    color: var(--text-soft);
    max-width: 620px;
  }

  .about-facts {
    margin: 0;
    display: grid;
    grid-template-columns: 110px minmax(0, 1fr);
    border-top: 1px solid var(--line);
    font-size: 15px;
    max-width: 620px;
  }

  .about-facts dt,
  .about-facts dd {
    margin: 0;
    padding: 12px 0;
    border-bottom: 1px solid var(--line);
  }

  .about-facts dt {
    font-family: var(--font-mono);
    font-size: 12px;
    text-transform: uppercase;
    color: var(--muted);
    padding-top: 14px;
  }

  .about-facts dd {
    color: var(--heading);
  }

  .about-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 24px;
    align-items: center;
  }

  @media (max-width: 860px) {
    .about {
      padding-block: 56px;
    }

    .about-grid {
      grid-template-columns: 1fr;
    }

    .about-photo {
      max-width: 280px;
    }
  }
</style>
