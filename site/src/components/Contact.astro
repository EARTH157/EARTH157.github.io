---
import Icon from './Icon.astro';
import { profile } from '../data/site';
---

<footer id="contact" class="contact blueprint on-ink">
  <div class="container contact-grid">
    <div class="contact-copy" data-reveal>
      <span class="eyebrow">05 / Contact</span>
      <h2>Let's build something together.</h2>
      <p>Interested in AI engineering and robotics roles. Email is the fastest way to reach me.</p>
      <a class="email" href={`mailto:${profile.email}`} data-goatcounter-click="email/contact-address">{profile.email}</a>
      <div class="contact-actions">
        <a class="btn btn-primary" href={`mailto:${profile.email}`} data-goatcounter-click="email/contact-button"><Icon name="mail" size={18} /> Email me</a>
        <a class="btn btn-ghost-ink" href={profile.cv} download data-goatcounter-click="cv-download/contact"><Icon name="download" size={16} /> Download CV</a>
      </div>
    </div>
    <div class="card-person" data-reveal="1">
      <div class="person-text">
        <span class="person-name">{profile.name}</span>
        <span class="mono person-role">{profile.role}</span>
        <div class="person-links">
          <a class="icon-btn" href={profile.github} aria-label="GitHub"><Icon name="github" size={20} /></a>
          <a class="icon-btn" href={profile.linkedin} aria-label="LinkedIn"><Icon name="linkedin" size={20} /></a>
          <a class="icon-btn" href={profile.youtube} aria-label="YouTube"><Icon name="youtube" size={20} /></a>
        </div>
      </div>
    </div>
  </div>
  <div class="container legal mono">
    <span>© {new Date().getFullYear()} {profile.name}</span>
    <span>earth157.github.io</span>
  </div>
</footer>

<style>
  .contact {
    padding: 88px 0 32px;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr));
    gap: 48px;
    align-items: center;
  }

  .contact-copy {
    display: flex;
    flex-direction: column;
    gap: 18px;
    min-width: 0;
  }

  h2 {
    font-size: clamp(36px, 5vw, 64px);
    line-height: 1.05;
  }

  .contact-copy p {
    color: var(--on-ink-soft);
    max-width: 540px;
    line-height: 1.7;
  }

  .email {
    font-family: var(--font-display);
    font-size: clamp(20px, 2.4vw, 28px);
    color: var(--on-ink-strong);
    text-decoration: underline;
    text-decoration-color: var(--clay-bright);
    text-underline-offset: 6px;
    overflow-wrap: anywhere;
  }

  .email:hover {
    color: var(--clay-light);
  }

  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  /* Sign-off card: name, role and social links in a framed block */
  .card-person {
    justify-self: end;
    width: min(100%, 380px);
    padding: 28px;
    border: 1px solid var(--on-ink-line);
    border-left: 3px solid var(--clay-bright);
    border-radius: var(--radius);
    background: rgba(239, 233, 226, 0.03);
  }

  .person-text {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .person-name {
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 700;
    color: var(--on-ink-strong);
  }

  .person-role {
    font-size: 12px;
    color: var(--on-ink-muted);
  }

  .person-links {
    display: flex;
    gap: 10px;
    margin-top: 8px;
  }

  .legal {
    margin-top: 56px;
    padding-top: 24px;
    border-top: 1px solid var(--on-ink-line);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px;
    font-size: 12px;
    color: #9C938A;
  }

  @media (max-width: 640px) {
    .contact {
      padding-top: 56px;
    }

    .contact-actions .btn {
      flex: 1 1 100%;
    }

    .card-person {
      justify-self: stretch;
      width: auto;
    }
  }
</style>
