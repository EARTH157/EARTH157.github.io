---
// Small inline stroke icons, decorative (aria-hidden); label the surrounding control instead
interface Props {
  name: 'arrow-right' | 'arrow-up-right' | 'chevron-left' | 'chevron-right' | 'github' | 'linkedin' | 'youtube' | 'play' | 'close' | 'menu' | 'download' | 'mail';
  size?: number;
}

const { name, size = 18 } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill={name === 'play' ? 'currentColor' : 'none'}
  stroke={name === 'play' ? 'none' : 'currentColor'}
  stroke-width="1.9"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {name === 'arrow-right' && (<><path d="M5 12h14" /><path d="M13 6l6 6-6 6" /></>)}
  {name === 'arrow-up-right' && (<><path d="M7 17L17 7" /><path d="M8 7h9v9" /></>)}
  {name === 'chevron-left' && <path d="M15 6l-6 6 6 6" />}
  {name === 'chevron-right' && <path d="M9 6l6 6-6 6" />}
  {name === 'github' && (
    <path d="M9 19c-4.3 1.4-4.3-2.5-6-3m12 5v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12.3 12.3 0 0 0-6.2 0C6.5 2.8 5.4 3.1 5.4 3.1a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 9.5c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21" />
  )}
  {name === 'linkedin' && (<><rect x="3" y="3" width="18" height="18" rx="3" /><path d="M8 11v5" /><path d="M8 8v.01" /><path d="M12 16v-5" /><path d="M16 16v-3a2 2 0 0 0-4 0" /></>)}
  {name === 'youtube' && (<><rect x="2.5" y="5" width="19" height="14" rx="4" /><path d="M10 9.5l5 2.5-5 2.5z" /></>)}
  {name === 'play' && <path d="M7 4l13 8-13 8z" />}
  {name === 'close' && (<><path d="M6 6l12 12" /><path d="M18 6L6 18" /></>)}
  {name === 'menu' && (<><path d="M4 7h16" /><path d="M4 12h16" /><path d="M4 17h16" /></>)}
  {name === 'download' && (<><path d="M12 4v11" /><path d="M7 10l5 5 5-5" /><path d="M5 20h14" /></>)}
  {name === 'mail' && (<><rect x="3" y="5" width="18" height="14" rx="2" /><path d="M3 7l9 6 9-6" /></>)}
</svg>
