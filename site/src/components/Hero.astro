---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import RobotViewer from './RobotViewer.astro';
import portrait from '../assets/profile.webp';
import { profile, robots, stats } from '../data/site';

const navLinks = [
  { n: '01', label: 'Work', href: '#work' },
  { n: '02', label: 'About', href: '#about' },
  { n: '03', label: 'Projects', href: '#projects' },
  { n: '04', label: 'Experience', href: '#experience' },
  { n: '05', label: 'Contact', href: '#contact' },
];
---

<header class="hero blueprint on-ink">
  <nav class="nav container" aria-label="Main">
    <a href="#main" class="logo">JC<span>.</span></a>
    <ul class="nav-links" id="nav-links">
      {navLinks.map((l) => (
        <li><a href={l.href}><span>{l.n}</span> {l.label}</a></li>
      ))}
    </ul>
    <div class="nav-actions">
      <a class="btn btn-ghost-ink nav-cv" href={profile.cv} download aria-label="Download CV">
        <Icon name="download" size={16} /> <span>Download CV</span>
      </a>
      <button class="icon-btn nav-toggle" aria-label="Open menu" aria-expanded="false" aria-controls="nav-links">
        <Icon name="menu" size={20} />
      </button>
    </div>
  </nav>

  <div id="main" class="hero-grid container">
    <div class="hero-copy">
      <a class="hello" href="#about">
        <Image src={portrait} alt="" widths={[64, 128]} sizes="56px" class="hello-avatar" loading="eager" />
        <span class="hello-text"><span>Hi, I'm</span> <strong>{profile.name}</strong></span>
      </a>
      <div class="hero-meta">
        <span class="eyebrow">// {profile.role}</span>
        <span class="status"><span class="status-dot"></span>{profile.current}</span>
      </div>
      <h1>{profile.headline}</h1>
      <p class="hero-intro">{profile.intro}</p>
      <div class="hero-actions">
        <a class="btn btn-primary" href="#work">View case studies <Icon name="arrow-right" size={16} /></a>
        <a class="icon-btn" href={profile.github} aria-label="GitHub"><Icon name="github" size={20} /></a>
        <a class="icon-btn" href={profile.linkedin} aria-label="LinkedIn"><Icon name="linkedin" size={20} /></a>
        <a class="icon-btn" href={profile.youtube} aria-label="YouTube"><Icon name="youtube" size={20} /></a>
      </div>
    </div>

    <RobotViewer robots={robots} />
  </div>

  <div class="container">
    <dl class="stats">
      {stats.map((s, i) => (
        <div data-reveal={i}>
          <dt class="sr-only">{s.label}</dt>
          <dd>
            <span class="stat-value">{s.value}</span>
            <span class="stat-label" aria-hidden="true">{s.label}</span>
          </dd>
        </div>
      ))}
    </dl>
  </div>
</header>

<style>
  .hero {
    padding-bottom: 56px;
  }

  .nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-block: 18px;
  }

  .logo {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 20px;
    letter-spacing: 0.06em;
    color: var(--on-ink);
    text-decoration: none;
  }

  .logo span {
    color: var(--clay-bright);
  }

  .nav-links {
    display: flex;
    gap: 28px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-mono);
    font-size: 13px;
  }

  .nav-links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: #D9D2CA;
    text-decoration: none;
  }

  .nav-links a:hover {
    color: var(--on-ink-strong);
  }

  .nav-links a span {
    color: var(--clay-light);
    margin-right: 6px;
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .nav-cv {
    min-height: 44px;
    font-size: 14px;
    font-weight: 500;
  }

  .nav-toggle {
    display: none;
    width: 44px;
    height: 44px;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 480px), 1fr));
    gap: 48px;
    align-items: center;
    padding-block: 40px;
  }

  .hero-copy {
    display: flex;
    flex-direction: column;
    gap: 24px;
    min-width: 0;
  }

  .hero-copy > * {
    animation: rise 0.9s var(--ease) both;
  }

  .hero-copy > :nth-child(2) { animation-delay: 0.08s; }
  .hero-copy > :nth-child(3) { animation-delay: 0.16s; }
  .hero-copy > :nth-child(4) { animation-delay: 0.24s; }
  .hero-copy > :nth-child(5) { animation-delay: 0.32s; }

  /* Who this is, before the headline: avatar + name, linking to the About section */
  .hello {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 14px;
    padding: 6px 18px 6px 6px;
    border: 1px solid rgba(239, 233, 226, 0.16);
    border-radius: 999px;
    background: rgba(239, 233, 226, 0.04);
    color: var(--on-ink);
    text-decoration: none;
    transition: border-color 0.2s;
  }

  .hello:hover {
    border-color: var(--clay-bright);
    color: var(--on-ink-strong);
  }

  .hello :global(.hello-avatar) {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    object-fit: cover;
    object-position: top;
    background: linear-gradient(180deg, #FBF9F6 0%, #EDE6DE 100%);
    border: 2px solid var(--clay-bright);
  }

  .hello-text {
    display: flex;
    flex-direction: column;
    line-height: 1.25;
  }

  .hello-text span {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--on-ink-muted);
  }

  .hello-text strong {
    font-family: var(--font-display);
    font-size: 18px;
    font-weight: 700;
    color: var(--on-ink-strong);
  }

  @keyframes rise {
    from { opacity: 0; transform: translateY(24px); }
    to { opacity: 1; transform: none; }
  }

  .hero-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px;
    border-radius: 999px;
    border: 1px solid rgba(239, 233, 226, 0.18);
    font-family: var(--font-mono);
    font-size: 12px;
    color: #D9D2CA;
  }

  .status-dot {
    position: relative;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #3FB950;
  }

  .status-dot::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: #3FB950;
    animation: ping 2s cubic-bezier(0, 0, 0.2, 1) infinite;
  }

  @keyframes ping {
    75%, 100% { transform: scale(2.6); opacity: 0; }
  }

  h1 {
    font-weight: 700;
    font-size: clamp(42px, 6vw, 80px);
    line-height: 1.02;
    letter-spacing: -0.02em;
  }

  .hero-grid > :global(.robot) {
    animation: rise 1.1s var(--ease) 0.3s both;
  }

  .hero-intro {
    font-size: 18px;
    color: var(--on-ink-soft);
    max-width: 540px;
  }

  .hero-intro strong {
    color: var(--on-ink-strong);
    font-weight: 600;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
    margin: 0;
    border-top: 1px solid var(--on-ink-line);
  }

  .stats dd {
    margin: 0;
    padding: 24px 24px 0 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .stat-value {
    font-family: var(--font-display);
    font-size: 40px;
    font-weight: 700;
    color: var(--on-ink-strong);
    line-height: 1.2;
  }

  .stat-label {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--on-ink-muted);
  }

  @media (max-width: 860px) {
    .nav-toggle {
      display: inline-flex;
    }

    .nav-cv span {
      display: none;
    }

    .nav-cv {
      padding: 0 14px;
    }

    .nav-links {
      display: none;
      order: 3;
      width: 100%;
      flex-direction: column;
      gap: 0;
      border-top: 1px solid var(--on-ink-line);
    }

    .nav-links.is-open {
      display: flex;
    }

    .nav-links li {
      border-bottom: 1px solid var(--on-ink-line);
    }

    .nav-links a {
      width: 100%;
      min-height: 52px;
      font-size: 15px;
    }

    .hero-grid {
      gap: 32px;
      padding-block: 24px;
    }

    .stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .stats dd {
      padding-right: 12px;
    }

    .stat-value {
      font-size: 28px;
    }

    .stat-label {
      font-size: 11px;
    }

  }

  @media (max-width: 480px) {
    .hero-actions .btn-primary {
      flex: 1 1 100%;
    }
  }
</style>

<script>
  const nav = document.querySelector<HTMLElement>('.nav-links');
  const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
  toggle?.addEventListener('click', () => {
    const open = !nav?.classList.contains('is-open');
    nav?.classList.toggle('is-open', open);
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  });
  nav?.querySelectorAll('a').forEach((a) =>
    a.addEventListener('click', () => {
      nav.classList.remove('is-open');
      toggle?.setAttribute('aria-expanded', 'false');
      toggle?.setAttribute('aria-label', 'Open menu');
    }),
  );
</script>
