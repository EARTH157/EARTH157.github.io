---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import portrait from '../assets/profile.webp';
import { profile, disciplines, stats } from '../data/site';

const [firstName, ...rest] = profile.name.split(' ');
const lastName = rest.join(' ');

const navLinks = [
  { n: '01', label: 'Work', href: '#work' },
  { n: '02', label: 'About', href: '#about' },
  { n: '03', label: 'Projects', href: '#projects' },
  { n: '04', label: 'Experience', href: '#experience' },
  { n: '05', label: 'Contact', href: '#contact' },
];
---

<header class="hero blueprint on-ink">
  <nav class="nav container" aria-label="Main">
    <a href="#main" class="logo">JC<span>.</span></a>
    <ul class="nav-links" id="nav-links">
      {navLinks.map((l) => (
        <li><a href={l.href}><span>{l.n}</span> {l.label}</a></li>
      ))}
    </ul>
    <div class="nav-actions">
      <a class="btn btn-ghost-ink nav-cv" href={profile.cv} download aria-label="Download CV" data-goatcounter-click="cv-download/nav">
        <Icon name="download" size={16} /> <span>Download CV</span>
      </a>
      <button class="icon-btn nav-toggle" aria-label="Open menu" aria-expanded="false" aria-controls="nav-links">
        <Icon name="menu" size={20} />
      </button>
    </div>
  </nav>

  <div id="main" class="cover container">
    <div class="cover-copy">
      <div class="hero-meta">
        <span class="eyebrow">// {profile.role}</span>
        <span class="status"><span class="status-dot"></span>{profile.current}</span>
      </div>
      <h1 class="cover-name">
        <span class="hi">Hi, I'm</span>
        <span class="first">{firstName}</span>
        <span class="last">{lastName}</span>
      </h1>
      <p class="tagline">{profile.headline}</p>
      <p class="hero-intro">{profile.intro}</p>
      <ul class="disciplines">
        {disciplines.map((d) => (
          <li>
            <span class="mono d-n">{d.n}</span>
            <strong>{d.title}</strong>
            <span class="d-text">{d.text}</span>
          </li>
        ))}
      </ul>
      <div class="hero-actions">
        <a class="btn btn-primary" href="#work">See my work <Icon name="arrow-right" size={16} /></a>
        <a class="btn btn-ghost-ink" href="#about">About me</a>
        <span class="socials">
          <a class="icon-btn" href={profile.github} aria-label="GitHub"><Icon name="github" size={20} /></a>
          <a class="icon-btn" href={profile.linkedin} aria-label="LinkedIn"><Icon name="linkedin" size={20} /></a>
          <a class="icon-btn" href={profile.youtube} aria-label="YouTube"><Icon name="youtube" size={20} /></a>
        </span>
      </div>
    </div>

    <figure class="cover-portrait">
      <span class="arch" aria-hidden="true"></span>
      <Image
        src={portrait}
        alt={`Portrait of ${profile.name}`}
        widths={[360, 560, 823]}
        sizes="(min-width: 1100px) 520px, (min-width: 860px) 42vw, 80vw"
        loading="eager"
        fetchpriority="high"
        class="portrait-img"
      />
      <span class="crop crop-tl" aria-hidden="true"></span>
      <span class="crop crop-tr" aria-hidden="true"></span>
      <figcaption class="mono">FIG. 00 · The engineer</figcaption>
    </figure>
  </div>

  <div class="container">
    <dl class="stats">
      {stats.map((s, i) => (
        <div data-reveal={i}>
          <dt class="sr-only">{s.label}</dt>
          <dd>
            <span class="stat-value">{s.value}</span>
            <span class="stat-label" aria-hidden="true">{s.label}</span>
          </dd>
        </div>
      ))}
    </dl>
  </div>
</header>

<style>
  .hero {
    padding-bottom: 56px;
  }

  .nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-block: 18px;
  }

  .logo {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 20px;
    letter-spacing: 0.06em;
    color: var(--on-ink);
    text-decoration: none;
  }

  .logo span {
    color: var(--clay-bright);
  }

  .nav-links {
    display: flex;
    gap: 28px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-mono);
    font-size: 13px;
  }

  .nav-links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: #D9D2CA;
    text-decoration: none;
  }

  .nav-links a:hover {
    color: var(--on-ink-strong);
  }

  .nav-links a span {
    color: var(--clay-light);
    margin-right: 6px;
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .nav-cv {
    min-height: 44px;
    font-size: 14px;
    font-weight: 500;
  }

  .nav-toggle {
    display: none;
    width: 44px;
    height: 44px;
  }

  /* Cover: who I am first, robots come later in Work */
  .cover {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: clamp(32px, 5vw, 72px);
    align-items: end;
    padding-top: clamp(24px, 4vw, 48px);
  }

  .cover-copy {
    display: flex;
    flex-direction: column;
    gap: 22px;
    min-width: 0;
    padding-bottom: 48px;
  }

  .cover-copy > * {
    animation: rise 0.9s var(--ease) both;
  }

  .cover-copy > :nth-child(2) { animation-delay: 0.08s; }
  .cover-copy > :nth-child(3) { animation-delay: 0.16s; }
  .cover-copy > :nth-child(4) { animation-delay: 0.22s; }
  .cover-copy > :nth-child(5) { animation-delay: 0.28s; }
  .cover-copy > :nth-child(6) { animation-delay: 0.34s; }

  .cover-name {
    display: flex;
    flex-direction: column;
    margin: 0;
    font-weight: 700;
    line-height: 0.95;
    letter-spacing: -0.03em;
  }

  .cover-name .hi {
    font-family: var(--font-mono);
    font-size: 15px;
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--clay-light);
    margin-bottom: 14px;
  }

  .cover-name .first {
    font-size: clamp(56px, 8.4vw, 124px);
    color: var(--on-ink-strong);
  }

  .cover-name .last {
    font-size: clamp(34px, 5.1vw, 76px);
    color: transparent;
    -webkit-text-stroke: 1.5px var(--on-ink);
    margin-top: 6px;
    overflow-wrap: anywhere;
  }

  .tagline {
    font-family: var(--font-display);
    font-size: clamp(22px, 2.2vw, 30px);
    font-weight: 600;
    line-height: 1.2;
    color: var(--clay-light);
  }

  .disciplines {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--on-ink-line);
  }

  .disciplines li {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 14px 16px 0 0;
  }

  .disciplines li + li {
    padding-left: 16px;
    border-left: 1px solid var(--on-ink-line);
  }

  .d-n {
    font-size: 11px;
    color: var(--clay-light);
  }

  .disciplines strong {
    font-family: var(--font-display);
    font-size: 18px;
    color: var(--on-ink-strong);
  }

  .d-text {
    font-size: 13px;
    line-height: 1.45;
    color: var(--on-ink-muted);
  }

  .socials {
    display: inline-flex;
    gap: 10px;
  }

  /* Portrait: transparent cut-out standing in a clay arch, like a figure on a drawing sheet */
  .cover-portrait {
    position: relative;
    margin: 0;
    align-self: end;
    justify-self: center;
    width: min(100%, 520px);
    aspect-ratio: 823 / 900;
    animation: rise 1.1s var(--ease) 0.2s both;
  }

  .arch {
    position: absolute;
    left: 7%;
    right: 7%;
    bottom: 0;
    height: 88%;
    border-radius: 999px 999px 0 0;
    background:
      radial-gradient(120% 80% at 50% 15%, rgba(232, 149, 122, 0.55), rgba(164, 85, 58, 0.25) 60%, rgba(164, 85, 58, 0.1)),
      repeating-linear-gradient(0deg, rgba(239, 233, 226, 0.06) 0 1px, transparent 1px 24px),
      repeating-linear-gradient(90deg, rgba(239, 233, 226, 0.06) 0 1px, transparent 1px 24px);
    border: 1px solid rgba(232, 149, 122, 0.5);
    border-bottom: 0;
  }

  .cover-portrait :global(.portrait-img) {
    position: relative;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: bottom;
  }

  .crop {
    position: absolute;
    width: 22px;
    height: 22px;
    border-color: var(--clay-bright);
    border-style: solid;
    border-width: 0;
  }

  .crop-tl { top: 0; left: 0; border-top-width: 2px; border-left-width: 2px; }
  .crop-tr { top: 0; right: 0; border-top-width: 2px; border-right-width: 2px; }

  .cover-portrait figcaption {
    position: absolute;
    bottom: calc(100% + 8px);
    left: 0;
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--on-ink-muted);
  }

  @keyframes rise {
    from { opacity: 0; transform: translateY(24px); }
    to { opacity: 1; transform: none; }
  }

  .hero-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px;
    border-radius: 999px;
    border: 1px solid rgba(239, 233, 226, 0.18);
    font-family: var(--font-mono);
    font-size: 12px;
    color: #D9D2CA;
  }

  .status-dot {
    position: relative;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #3FB950;
  }

  .status-dot::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: #3FB950;
    animation: ping 2s cubic-bezier(0, 0, 0.2, 1) infinite;
  }

  @keyframes ping {
    75%, 100% { transform: scale(2.6); opacity: 0; }
  }

  h1 {
    font-weight: 700;
    font-size: clamp(42px, 6vw, 80px);
    line-height: 1.02;
    letter-spacing: -0.02em;
  }

  .hero-intro {
    font-size: 18px;
    color: var(--on-ink-soft);
    max-width: 540px;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
    margin: 0;
    border-top: 1px solid var(--on-ink-line);
  }

  .stats dd {
    margin: 0;
    padding: 24px 24px 0 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .stat-value {
    font-family: var(--font-display);
    font-size: 40px;
    font-weight: 700;
    color: var(--on-ink-strong);
    line-height: 1.2;
  }

  .stat-label {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--on-ink-muted);
  }

  @media (max-width: 860px) {
    .nav-toggle {
      display: inline-flex;
    }

    .nav-cv span {
      display: none;
    }

    .nav-cv {
      padding: 0 14px;
    }

    .nav-links {
      display: none;
      order: 3;
      width: 100%;
      flex-direction: column;
      gap: 0;
      border-top: 1px solid var(--on-ink-line);
    }

    .nav-links.is-open {
      display: flex;
    }

    .nav-links li {
      border-bottom: 1px solid var(--on-ink-line);
    }

    .nav-links a {
      width: 100%;
      min-height: 52px;
      font-size: 15px;
    }

    .cover {
      grid-template-columns: 1fr;
      gap: 8px;
    }

    .cover-portrait {
      order: -1;
      width: min(78%, 340px);
      margin-top: 28px;
    }

    /* Single column: give the cut-out a ground line instead of the stats rule */
    .cover-portrait::after {
      content: '';
      position: absolute;
      left: -12%;
      right: -12%;
      bottom: 0;
      border-bottom: 1px solid var(--on-ink-line);
    }

    .cover-copy {
      padding-bottom: 40px;
    }

    .stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .stats dd {
      padding-right: 12px;
    }

    .stat-value {
      font-size: 28px;
    }

    .stat-label {
      font-size: 11px;
    }

  }

  @media (max-width: 560px) {
    .disciplines {
      grid-template-columns: 1fr;
    }

    .disciplines li,
    .disciplines li + li {
      display: grid;
      grid-template-columns: 28px 90px minmax(0, 1fr);
      align-items: baseline;
      padding: 10px 0;
      border-left: 0;
      border-bottom: 1px solid var(--on-ink-line);
    }

    .hero-actions .btn {
      flex: 1 1 calc(50% - 6px);
    }
  }
</style>

<script>
  const nav = document.querySelector<HTMLElement>('.nav-links');
  const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
  toggle?.addEventListener('click', () => {
    const open = !nav?.classList.contains('is-open');
    nav?.classList.toggle('is-open', open);
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  });
  nav?.querySelectorAll('a').forEach((a) =>
    a.addEventListener('click', () => {
      nav.classList.remove('is-open');
      toggle?.setAttribute('aria-expanded', 'false');
      toggle?.setAttribute('aria-label', 'Open menu');
    }),
  );
</script>
