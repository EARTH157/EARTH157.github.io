---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { profile, robots, stats } from '../data/site';

const navLinks = [
  { n: '01', label: 'Work', href: '#work' },
  { n: '02', label: 'Projects', href: '#projects' },
  { n: '03', label: 'Experience', href: '#experience' },
  { n: '04', label: 'Contact', href: '#contact' },
];
const first = robots[0];
---

<header class="hero blueprint on-ink">
  <nav class="nav container" aria-label="Main">
    <a href="#main" class="logo">JC<span>.</span></a>
    <ul class="nav-links" id="nav-links">
      {navLinks.map((l) => (
        <li><a href={l.href}><span>{l.n}</span> {l.label}</a></li>
      ))}
    </ul>
    <div class="nav-actions">
      <a class="btn btn-ghost-ink nav-cv" href={profile.cv} download aria-label="Download CV">
        <Icon name="download" size={16} /> <span>Download CV</span>
      </a>
      <button class="icon-btn nav-toggle" aria-label="Open menu" aria-expanded="false" aria-controls="nav-links">
        <Icon name="menu" size={20} />
      </button>
    </div>
  </nav>

  <div id="main" class="hero-grid container">
    <div class="hero-copy">
      <div class="hero-meta">
        <span class="eyebrow">// {profile.role}</span>
        <span class="status"><span class="status-dot"></span>{profile.current}</span>
      </div>
      <h1>{profile.headline}</h1>
      <p class="hero-intro">I'm <strong>{profile.name}</strong>. {profile.intro}</p>
      <div class="hero-actions">
        <a class="btn btn-primary" href="#work">View case studies <Icon name="arrow-right" size={16} /></a>
        <a class="icon-btn" href={profile.github} aria-label="GitHub"><Icon name="github" size={20} /></a>
        <a class="icon-btn" href={profile.linkedin} aria-label="LinkedIn"><Icon name="linkedin" size={20} /></a>
        <a class="icon-btn" href={profile.youtube} aria-label="YouTube"><Icon name="youtube" size={20} /></a>
      </div>
    </div>

    <figure class="robot" data-robot-viewer>
      <div class="robot-stage">
        {robots.map((r, i) => (
          <Image
            src={r.poster}
            alt={r.alt}
            widths={[360, 560, 840]}
            sizes="(min-width: 980px) 520px, 90vw"
            loading={i === 0 ? 'eager' : 'lazy'}
            fetchpriority={i === 0 ? 'high' : 'auto'}
            class="robot-poster"
            data-poster={r.id}
            hidden={i !== 0}
          />
        ))}
        <div class="robot-canvas" aria-hidden="true"></div>
        <span class="robot-badge">3D MODEL</span>
        <button class="robot-3d-btn" type="button" hidden>View in 3D</button>
        <p class="robot-status" role="status"></p>
        {robots.map((r, i) => (
          <ul class="callouts" data-callouts={r.id} hidden={i !== 0}>
            {r.callouts.map((c, j) => (
              <li class={`callout callout-${j}`}>
                <b>{c.title}</b>
                {c.lines.map((line) => <span>{line}</span>)}
              </li>
            ))}
          </ul>
        ))}
      </div>
      <figcaption class="robot-caption">
        <span><span class="robot-fig">FIG. <span data-fig>01</span> / {String(robots.length).padStart(2, '0')}</span> · <span data-name>{first.name}</span></span>
        <span data-meta>{first.meta}</span>
      </figcaption>
      <div class="robot-picker" role="group" aria-label="Choose a robot to display">
        <button class="icon-btn" type="button" data-step="-1" aria-label="Previous robot"><Icon name="chevron-left" /></button>
        {robots.map((r, i) => (
          <button class="robot-tab" type="button" data-robot={r.id} data-model={r.model} data-name={r.name} data-meta={r.meta} aria-pressed={i === 0 ? 'true' : 'false'}>
            {r.label}
          </button>
        ))}
        <button class="icon-btn" type="button" data-step="1" aria-label="Next robot"><Icon name="chevron-right" /></button>
      </div>
    </figure>
  </div>

  <div class="container">
    <dl class="stats">
      {stats.map((s, i) => (
        <div data-reveal={i}>
          <dt class="sr-only">{s.label}</dt>
          <dd>
            <span class="stat-value">{s.value}</span>
            <span class="stat-label" aria-hidden="true">{s.label}</span>
          </dd>
        </div>
      ))}
    </dl>
  </div>
</header>

<style>
  .hero {
    padding-bottom: 56px;
  }

  .nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-block: 18px;
  }

  .logo {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 20px;
    letter-spacing: 0.06em;
    color: var(--on-ink);
    text-decoration: none;
  }

  .logo span {
    color: var(--clay-bright);
  }

  .nav-links {
    display: flex;
    gap: 28px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-mono);
    font-size: 13px;
  }

  .nav-links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: #D9D2CA;
    text-decoration: none;
  }

  .nav-links a:hover {
    color: var(--on-ink-strong);
  }

  .nav-links a span {
    color: var(--clay-light);
    margin-right: 6px;
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .nav-cv {
    min-height: 44px;
    font-size: 14px;
    font-weight: 500;
  }

  .nav-toggle {
    display: none;
    width: 44px;
    height: 44px;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 480px), 1fr));
    gap: 48px;
    align-items: center;
    padding-block: 40px;
  }

  .hero-copy {
    display: flex;
    flex-direction: column;
    gap: 24px;
    min-width: 0;
  }

  .hero-copy > * {
    animation: rise 0.9s var(--ease) both;
  }

  .hero-copy > :nth-child(2) { animation-delay: 0.1s; }
  .hero-copy > :nth-child(3) { animation-delay: 0.2s; }
  .hero-copy > :nth-child(4) { animation-delay: 0.3s; }

  @keyframes rise {
    from { opacity: 0; transform: translateY(24px); }
    to { opacity: 1; transform: none; }
  }

  .hero-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px;
    border-radius: 999px;
    border: 1px solid rgba(239, 233, 226, 0.18);
    font-family: var(--font-mono);
    font-size: 12px;
    color: #D9D2CA;
  }

  .status-dot {
    position: relative;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #3FB950;
  }

  .status-dot::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: #3FB950;
    animation: ping 2s cubic-bezier(0, 0, 0.2, 1) infinite;
  }

  @keyframes ping {
    75%, 100% { transform: scale(2.6); opacity: 0; }
  }

  h1 {
    font-weight: 700;
    font-size: clamp(42px, 6vw, 80px);
    line-height: 1.02;
    letter-spacing: -0.02em;
  }

  .hero-intro {
    font-size: 18px;
    color: var(--on-ink-soft);
    max-width: 540px;
  }

  .hero-intro strong {
    color: var(--on-ink-strong);
    font-weight: 600;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
  }

  .robot {
    margin: 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 18px;
    animation: rise 1.1s var(--ease) 0.3s both;
  }

  .robot-stage {
    position: relative;
    width: 100%;
    max-width: 520px;
    aspect-ratio: 1 / 1;
    align-self: center;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .robot-poster {
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: drop-shadow(0 30px 40px rgba(0, 0, 0, 0.45));
    transition: opacity 0.5s;
  }

  .robot-poster[hidden] {
    display: none;
  }

  .robot-canvas {
    position: absolute;
    inset: 0;
    z-index: 1;
    opacity: 0;
    transition: opacity 0.6s;
    cursor: grab;
  }

  .robot-canvas:active {
    cursor: grabbing;
  }

  .robot.is-3d .robot-canvas {
    opacity: 1;
  }

  .robot.is-3d .robot-poster {
    opacity: 0;
  }

  .robot-badge {
    position: absolute;
    z-index: 2;
    top: 0;
    left: 0;
    padding: 4px 10px;
    border: 1px solid rgba(232, 149, 122, 0.45);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    color: var(--clay-light);
    background: rgba(22, 20, 18, 0.7);
  }

  .robot-3d-btn {
    position: absolute;
    z-index: 2;
    bottom: 8px;
    left: 50%;
    transform: translateX(-50%);
    min-height: 44px;
    padding: 0 18px;
    border-radius: 999px;
    border: 1px solid rgba(239, 233, 226, 0.35);
    background: rgba(22, 20, 18, 0.8);
    color: var(--on-ink);
    font: inherit;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
  }

  .robot-status {
    position: absolute;
    z-index: 2;
    bottom: 8px;
    right: 0;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--on-ink-muted);
  }

  .callouts {
    position: absolute;
    inset: 0;
    z-index: 2;
    margin: 0;
    padding: 0;
    list-style: none;
    pointer-events: none;
  }

  .callouts[hidden] {
    display: none;
  }

  .callout {
    position: absolute;
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.04em;
    color: #D9D2CA;
    white-space: nowrap;
  }

  .callout b {
    color: var(--clay-light);
    font-weight: 600;
  }

  .callout::before {
    content: '';
    position: absolute;
    height: 1px;
    background: rgba(232, 149, 122, 0.6);
  }

  .callout-0 { left: 84%; top: 4%; }
  .callout-0::before { right: calc(100% + 8px); top: 8px; width: 80px; }
  .callout-1 { right: 92%; top: 37%; align-items: flex-end; text-align: right; }
  .callout-1::before { left: calc(100% + 8px); top: 8px; width: 60px; }
  .callout-2 { left: 100%; top: 82%; }
  .callout-2::before { right: calc(100% + 8px); top: 8px; width: 70px; }

  .robot-caption {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px;
    padding-top: 12px;
    border-top: 1px solid var(--on-ink-line);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    color: var(--on-ink-muted);
  }

  .robot-fig {
    color: var(--clay-light);
  }

  .robot-picker {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
  }

  .robot-picker .icon-btn {
    width: 44px;
    height: 44px;
  }

  .robot-tab {
    min-height: 44px;
    padding: 0 16px;
    border-radius: 999px;
    border: 1px solid rgba(239, 233, 226, 0.25);
    background: transparent;
    color: #D9D2CA;
    font-family: var(--font-mono);
    font-size: 12px;
    cursor: pointer;
  }

  .robot-tab[aria-pressed='true'] {
    background: var(--clay-bright);
    border-color: var(--clay-bright);
    color: var(--ink);
    font-weight: 600;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
    margin: 0;
    border-top: 1px solid var(--on-ink-line);
  }

  .stats dd {
    margin: 0;
    padding: 24px 24px 0 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .stat-value {
    font-family: var(--font-display);
    font-size: 40px;
    font-weight: 700;
    color: var(--on-ink-strong);
    line-height: 1.2;
  }

  .stat-label {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--on-ink-muted);
  }

  @media (max-width: 1100px) {
    .callouts {
      display: none;
    }
  }

  @media (max-width: 860px) {
    .nav-toggle {
      display: inline-flex;
    }

    .nav-cv span {
      display: none;
    }

    .nav-cv {
      padding: 0 14px;
    }

    .nav-links {
      display: none;
      order: 3;
      width: 100%;
      flex-direction: column;
      gap: 0;
      border-top: 1px solid var(--on-ink-line);
    }

    .nav-links.is-open {
      display: flex;
    }

    .nav-links li {
      border-bottom: 1px solid var(--on-ink-line);
    }

    .nav-links a {
      width: 100%;
      min-height: 52px;
      font-size: 15px;
    }

    .hero-grid {
      gap: 32px;
      padding-block: 24px;
    }

    .stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .stats dd {
      padding-right: 12px;
    }

    .stat-value {
      font-size: 28px;
    }

    .stat-label {
      font-size: 11px;
    }

    .robot-stage {
      max-width: 360px;
    }
  }

  @media (max-width: 480px) {
    .hero-actions .btn-primary {
      flex: 1 1 100%;
    }
  }
</style>

<script>
  import { initRobotViewer } from '../scripts/robot-viewer';

  const nav = document.querySelector<HTMLElement>('.nav-links');
  const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
  toggle?.addEventListener('click', () => {
    const open = !nav?.classList.contains('is-open');
    nav?.classList.toggle('is-open', open);
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  });
  nav?.querySelectorAll('a').forEach((a) =>
    a.addEventListener('click', () => {
      nav.classList.remove('is-open');
      toggle?.setAttribute('aria-expanded', 'false');
      toggle?.setAttribute('aria-label', 'Open menu');
    }),
  );

  const viewer = document.querySelector<HTMLElement>('[data-robot-viewer]');
  if (viewer) initRobotViewer(viewer);
</script>
