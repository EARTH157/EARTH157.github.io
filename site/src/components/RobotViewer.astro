---
// 3D robot viewer: rendered poster first, then a live three.js scene with callout labels that
// float next to points on the model. With one robot the picker is hidden.
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import type { robots as allRobots } from '../data/site';

interface Props {
  robots: typeof allRobots;
}

const { robots } = Astro.props;
const first = robots[0];
---

<figure class="robot" data-robot-viewer>
  <div class="robot-stage">
    {robots.map((r, i) => (
      <Image
        src={r.poster}
        alt={r.alt}
        widths={[360, 560, 840]}
        sizes="(min-width: 980px) 520px, 90vw"
        loading={i === 0 ? 'eager' : 'lazy'}
        fetchpriority={i === 0 ? 'high' : 'auto'}
        class="robot-poster"
        data-poster={r.id}
        hidden={i !== 0}
      />
    ))}
    <div class="robot-canvas" aria-hidden="true"></div>
    <svg class="leaders" aria-hidden="true"></svg>
    <span class="robot-badge">3D MODEL</span>
    <button class="robot-3d-btn" type="button" aria-pressed="false" hidden>View in 3D</button>
    <div class="robot-zoom" role="group" aria-label="Zoom the 3D model">
      <button class="zoom-btn" type="button" data-zoom="in" aria-label="Zoom in"><Icon name="plus" size={18} /></button>
      <button class="zoom-btn" type="button" data-zoom="out" aria-label="Zoom out"><Icon name="minus" size={18} /></button>
      <button class="zoom-btn" type="button" data-zoom="reset" aria-label="Reset view"><Icon name="reset" size={17} /></button>
    </div>
    <p class="robot-status" role="status"></p>
    {robots.map((r, i) => (
      <ul class="callouts" data-callouts={r.id} hidden={i !== 0} data-poster-centre={r.posterCentre && JSON.stringify(r.posterCentre)}>
        {r.callouts.map((c, j) => (
          <li class={`callout callout-${j}`} data-anchor={JSON.stringify(c.anchor)} data-poster-anchor={c.posterAnchor && JSON.stringify(c.posterAnchor)}>
            <b>{c.title}</b>
            {c.lines.map((line) => <span>{line}</span>)}
          </li>
        ))}
      </ul>
    ))}
  </div>
  <figcaption class="robot-caption">
    <span><span class="robot-fig">FIG. <span data-fig>01</span> / {String(robots.length).padStart(2, '0')}</span> · <span data-caption-name>{first.name}</span></span>
    <span data-caption-meta>{first.meta}</span>
  </figcaption>
  <div class="robot-picker" role="group" aria-label="Choose a robot to display" hidden={robots.length < 2}>
    <button class="icon-btn" type="button" data-step="-1" aria-label="Previous robot"><Icon name="chevron-left" /></button>
    {robots.map((r, i) => (
      <button class="robot-tab" type="button" data-robot={r.id} data-model={r.model} data-name={r.name} data-meta={r.meta} aria-pressed={i === 0 ? 'true' : 'false'}>
        {r.label}
      </button>
    ))}
    <button class="icon-btn" type="button" data-step="1" aria-label="Next robot"><Icon name="chevron-right" /></button>
  </div>
</figure>

<style>
  .robot {
    margin: 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .robot-stage {
    position: relative;
    /* Callouts show or hide by the stage's own width, not the viewport's */
    container-type: inline-size;
    width: 100%;
    max-width: 520px;
    aspect-ratio: 1 / 1;
    align-self: center;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* The poster is the 3D view's first frame, laid over the stage exactly like the canvas */
  .robot-poster {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: opacity 0.5s;
  }

  .robot-poster[hidden] {
    display: none;
  }

  .robot-canvas {
    position: absolute;
    inset: 0;
    z-index: 1;
    opacity: 0;
    transition: opacity 0.6s;
    cursor: grab;
  }

  .robot-canvas:active {
    cursor: grabbing;
  }

  .robot.is-3d .robot-canvas {
    opacity: 1;
  }

  .robot.is-3d .robot-poster {
    opacity: 0;
  }

  .robot-badge {
    position: absolute;
    z-index: 2;
    top: 0;
    left: 0;
    padding: 4px 10px;
    border: 1px solid rgba(232, 149, 122, 0.45);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    color: var(--clay-light);
    background: rgba(22, 20, 18, 0.7);
  }

  .robot-3d-btn {
    position: absolute;
    z-index: 2;
    bottom: 8px;
    left: 50%;
    transform: translateX(-50%);
    min-height: 44px;
    padding: 0 18px;
    border-radius: 999px;
    border: 1px solid rgba(239, 233, 226, 0.35);
    background: rgba(22, 20, 18, 0.8);
    color: var(--on-ink);
    font: inherit;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
  }

  .robot-status {
    position: absolute;
    z-index: 2;
    bottom: 8px;
    right: 0;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--on-ink-muted);
  }

  .callouts {
    position: absolute;
    inset: 0;
    z-index: 2;
    margin: 0;
    padding: 0;
    list-style: none;
    pointer-events: none;
  }

  .callouts[hidden] {
    display: none;
  }

  .callout {
    position: absolute;
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.04em;
    color: #D9D2CA;
    white-space: nowrap;
    /* Labels sit inside the stage, so give them a backing in case they overlap the robot */
    padding: 6px 8px;
    border: 1px solid rgba(232, 149, 122, 0.25);
    border-radius: 6px;
    background: rgba(22, 20, 18, 0.72);
  }

  .callout b {
    color: var(--clay-light);
    font-weight: 600;
  }

  .callout::before {
    content: '';
    position: absolute;
    height: 1px;
    background: rgba(232, 149, 122, 0.6);
  }

  /* Once JS places the labels, they float next to their points and SVG leaders replace the static ones */
  .robot.is-floating .callout {
    left: 0;
    top: 0;
    right: auto;
    bottom: auto;
    align-items: flex-start;
    text-align: left;
    will-change: transform;
  }

  .robot.is-floating .callout::before {
    display: none;
  }


  .leaders {
    position: absolute;
    inset: 0;
    z-index: 2;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
    display: none;
  }

  .robot.is-floating .leaders {
    display: block;
  }

  .leaders :global(line) {
    stroke: rgba(232, 149, 122, 0.75);
    stroke-width: 1;
  }

  .leaders :global(circle) {
    fill: var(--clay-light);
    stroke: var(--ink);
    stroke-width: 2;
  }


  /* Top-right, middle-left and bottom-right corners of the stage, clear of the robot's centre */
  .callout-0 { right: 0; top: 3%; align-items: flex-end; text-align: right; }
  .callout-0::before { right: calc(100% + 6px); top: 13px; width: 40px; }
  .callout-1 { left: 0; top: 40%; }
  .callout-1::before { left: calc(100% + 6px); top: 13px; width: 40px; }
  .callout-2 { right: 0; bottom: 13%; align-items: flex-end; text-align: right; }
  .callout-2::before { right: calc(100% + 6px); top: 13px; width: 40px; }

  /* Small stages (phones): titles only, so the labels don't cover the robot */
  @container (max-width: 440px) {
    .callout {
      padding: 4px 7px;
      font-size: 10px;
    }

    .callout span {
      display: none;
    }

    /* The toggle button sits in the same spot; keep the status for screen readers only */
    .robot-status {
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
    }
  }

  .robot-caption {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px;
    padding-top: 12px;
    border-top: 1px solid var(--on-ink-line);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    color: var(--on-ink-muted);
  }

  .robot-fig {
    color: var(--clay-light);
  }

  .robot-picker {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
  }

  .robot-picker .icon-btn {
    width: 44px;
    height: 44px;
  }

  .robot-tab {
    min-height: 44px;
    padding: 0 16px;
    border-radius: 999px;
    border: 1px solid rgba(239, 233, 226, 0.25);
    background: transparent;
    color: #D9D2CA;
    font-family: var(--font-mono);
    font-size: 12px;
    cursor: pointer;
  }

  .robot-tab[aria-pressed='true'] {
    background: var(--clay-bright);
    border-color: var(--clay-bright);
    color: var(--ink);
    font-weight: 600;
  }

  .robot-picker[hidden] {
    display: none;
  }

  /* Zoom controls: only while the live 3D scene is showing */
  .robot-zoom {
    position: absolute;
    left: 0;
    bottom: 8px;
    z-index: 3;
    display: none;
    flex-direction: column;
    gap: 6px;
  }

  .robot.is-3d .robot-zoom {
    display: flex;
  }

  .zoom-btn {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid rgba(239, 233, 226, 0.3);
    background: rgba(22, 20, 18, 0.8);
    color: var(--on-ink);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: border-color 0.2s, color 0.2s;
  }

  .zoom-btn:hover {
    border-color: var(--clay-bright);
    color: var(--clay-light);
  }

  @media (pointer: coarse) {
    .zoom-btn {
      width: 44px;
      height: 44px;
    }
  }

  @media (max-width: 860px) {
    .robot-stage {
      max-width: 360px;
    }
  }
</style>

<script>
  import { initRobotViewer } from '../scripts/robot-viewer';

  document.querySelectorAll<HTMLElement>('[data-robot-viewer]').forEach((viewer) => initRobotViewer(viewer));
</script>
